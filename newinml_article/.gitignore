# What make_newinml.py produces. Regenerate with:
#   python make_newinml.py
#
# The compiled PDF is tracked, so a reviewer's copy is in the history; the zip
# and the build directory are not, both being derivable from it and large.
build/
.build-work/
__pycache__/

# Anchored, so it cannot also match the NeurIPS formatting zip in style/,
# which is kept for provenance.
/icomp_newinml.zip
